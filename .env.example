# Copy to .env. Never commit .env or place secrets in VITE_/NEXT_PUBLIC_ variables.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
# Azure uses /openai/v1/responses; no API-version or embedding deployment is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DESMOS_API_KEY=
# Required before exposing the server beyond localhost. Use HTTPS via a reverse proxy.
APP_USERNAME=studio
APP_PASSWORD=
# Optional PDF import Python executable (otherwise python).
PYTHON=python
