# Copy to .env. Never commit .env or place secrets in VITE_/NEXT_PUBLIC_ variables.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
# Azure uses /openai/v1/responses; no API-version or embedding deployment is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DESMOS_API_KEY=
# Required before exposing the server beyond localhost. Use HTTPS via a reverse proxy.
APP_USERNAME=studio
APP_PASSWORD=
# Optional PDF import Python executable (otherwise python).
PYTHON=python

# local for a single computer; supabase for Vercel or a shared repository.
STUDIO_STORAGE=local
# Server-only cloud credentials. Use the transaction pooler URL (port 6543).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Local SQLite storage. Empty uses %LOCALAPPDATA%/MSA Question Studio/studio.sqlite
# on Windows, or ~/.local/share/MSA Question Studio/studio.sqlite elsewhere.
# Use a local, persistent disk. Keep the live file outside OneDrive/network shares.
STUDIO_DB_PATH=
# Traces include redacted prompt/question content by default in either storage mode.
# Set false to store metadata, errors and token usage only.
AUDIT_CAPTURE_CONTENT=true
