          "name": "Determinant of order 3",
          "page": 3,
          "latex": "|A|=a_{11}A_{11}+a_{12}A_{12}+a_{13}A_{13},\\quad A_{11}=a_{22}a_{33}-a_{23}a_{32},\\quad A_{12}=-(a_{21}a_{33}-a_{23}a_{31}),\\quad A_{13}=a_{21}a_{32}-a_{22}a_{31}",
          "syllabusIds": ["EM1-1.5"],
          "prerequisiteFor": ["EM1-1.7"],
          "conditions": "A_ij denotes a cofactor, not an element.",
          "evidence": {
            "file": "EM1 Notes - ver17Mar26.pdf",
            "section": "EM1-1.5 Determinant of a Square Matrix",
            "page": "14"
          }
        },
