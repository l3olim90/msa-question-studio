          "name": "De Moivre theorem",
          "page": 1,
          "latex": "(r\\angle\\theta)^n=r^n\\angle n\\theta=r^n(\\cos n\\theta+j\\sin n\\theta)",
          "syllabusIds": ["EM1-2.5"],
          "prerequisiteFor": [],
