          "id": "MSA-CART",
          "name": "Cartesian form and conjugate",
          "page": 1,
          "latex": "z=a+jb,\\quad j^2=-1,\\quad \\overline z=a-jb,\\quad z\\overline z=a^2+b^2",
          "syllabusIds": ["EM1-2.2"],
          "prerequisiteFor": ["EM1-2.3", "EM1-2.4", "EM1-2.5"],
          "conditions": "",
          "evidence": {
            "file": "EM1 Notes - ver17Mar26.pdf",
            "section": "EM1-2.2 Complex Numbers in Cartesian (Rectangular) Form",
            "page": "35"
          }
        },
        {
          "id": "MSA-POLAR",
          "name": "Polar and trigonometric forms",
          "page": 1,
          "latex": "z=r(\\cos\\theta+j\\sin\\theta)=r\\angle\\theta,\\quad r=|z|=\\sqrt{a^2+b^2},\\quad \\tan\\theta=\\frac{b}{a}",
          "syllabusIds": ["EM1-2.3"],
          "prerequisiteFor": ["EM1-2.4", "EM1-2.5"],
          "conditions": "Choose the correct quadrant; principal argument is in (-pi,pi]. Argument undefined for z=0; handle a=0 separately.",
          "evidence": {
            "file": "EM1 Notes - ver17Mar26.pdf",
            "section": "EM1-2.3 The Polar Form of a Complex Number",
            "page": "42"
          }
        },
        {
          "id": "MSA-POLAR-OPS",
          "name": "Polar multiplication and division",
          "page": 1,
          "latex": "z_1z_2=r_1r_2\\angle(\\theta_1+\\theta_2),\\quad \\frac{z_1}{z_2}=\\frac{r_1}{r_2}\\angle(\\theta_1-\\theta_2)",
          "syllabusIds": ["EM1-2.3"],
          "prerequisiteFor": ["EM1-2.4", "EM1-2.5"],
          "conditions": "Division requires z_2 nonzero. Reduce final arguments to the principal interval.",
          "evidence": {
            "file": "EM1 Notes - ver17Mar26.pdf",
            "section": "EM1-2.3 The Polar Form of a Complex Number",
            "page": "42"
          }
        },
        {
