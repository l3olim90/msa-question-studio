{
  "name": "msa-question-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev --hostname 127.0.0.1",
    "build": "vinext build",
    "start": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js start --hostname 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node scripts/run.mjs check && node scripts/run.mjs providers-check && node scripts/run.mjs retry-check && node scripts/run.mjs migration-check && node scripts/run.mjs env-only-check && node scripts/run.mjs updates-check && node scripts/run.mjs features-check && node scripts/run.mjs team-check && node scripts/run.mjs similar-check && node scripts/run.mjs source-retry-check && node scripts/run.mjs security-check && node scripts/run.mjs database-connection-check",
    "typecheck": "tsc --noEmit",
    "bank": "node --env-file-if-exists=.env scripts/run.mjs bank",
    "cloud": "node --env-file-if-exists=.env scripts/run.mjs cloud",
    "worker": "node --env-file-if-exists=.env scripts/run.mjs cloud-worker",
    "build:vercel": "node scripts/vercel-build.mjs",
    "cloud:verify": "node --env-file-if-exists=.env scripts/run.mjs cloud-verify",
    "repository:verify": "node --env-file-if-exists=.env scripts/run.mjs repository-verify"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.1",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "lucide-react": "1.31.0",
    "mathjs": "^15.2.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1"
}
